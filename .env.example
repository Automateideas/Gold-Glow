# Copy to .env.local and fill in. Never commit .env.local.

# --- Your Gold & Glow Supabase project (Dashboard → Project Settings → API) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# service_role key — SECRET, server-only (never use a NEXT_PUBLIC_ prefix for it)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Admin panel login (/admin) — checked by the site itself, no Supabase Auth ---
ADMIN_USERNAME=choose-an-admin-id
ADMIN_PASSWORD=choose-a-long-strong-password
# Optional: long random string used to sign the login cookie (recommended)
ADMIN_SESSION_SECRET=
