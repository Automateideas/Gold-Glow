# Copy to .env.local and fill in. Never commit .env.local.

# --- Database (Drizzle) — Supabase Dashboard → Connect → "Session pooler" URI ---
# Replace [YOUR-PASSWORD] with the database password. Then run: npm run db:migrate
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# --- Supabase Storage for product images (Dashboard → Settings → API Keys) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase SECRET key (sb_secret_...) — server-only, never use a NEXT_PUBLIC_ prefix.
# (Legacy service_role key also works.) Do NOT use the publishable key here.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Admin panel login (/admin) — checked by the site itself, no Supabase Auth ---
ADMIN_USERNAME=choose-an-admin-id
ADMIN_PASSWORD=choose-a-long-strong-password
# Optional: long random string used to sign the login cookie (recommended)
ADMIN_SESSION_SECRET=
